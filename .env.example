# Copy this file to .env (already gitignored) and fill in real values.
# Never commit .env, and never put the service role key in client code or in
# Coolify — it bypasses Row Level Security and is for this one-time,
# local-only migration script alone.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key-here

# Optional: override if your backup isn't at ~/Desktop/catchnscore-backup
# BACKUP_DIR=/path/to/catchnscore-backup
