# Copy to .env.local (gitignored) for local dev against a real Supabase
# project. In Coolify these are set as real build-time env vars instead —
# Vite picks them up from the actual environment the same way.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=paste-the-publishable-key-here
